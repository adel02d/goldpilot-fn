# Copia este archivo a .env y rellena tus credenciales.
# NUNCA subas el .env real a GitHub (está en .gitignore).

# 1) Crea el bot con @BotFather en Telegram → /newbot → te da el token
TELEGRAM_BOT_TOKEN=1234567890:AAEjEjEjEjEjEjEjEjEjEjEjEjEjEjEjEj

# 2) Escríbele a tu bot y mira tu chat_id en:
#    https://api.telegram.org/bot<TU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Opcional: datos de tu cuenta del concurso
FN_INITIAL_EQUITY=10000
FN_START_DATE=2026-11-03

# Opcional: nivel de logging (DEBUG/INFO/WARNING)
LOG_LEVEL=INFO
